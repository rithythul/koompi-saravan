{
  "id": "publisher",
  "name": "Sarawan Publisher",
  "description": "Multi-platform social media publishing, analytics, and content automation for Instagram, TikTok, YouTube, Facebook, Pinterest, LinkedIn, Telegram, and X",
  "version": "1.0.0",
  "main": "index.ts",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "geminiApiKey": {
        "type": "string",
        "description": "Google AI Studio API key for Gemini"
      },
      "defaultOutputDir": {
        "type": "string",
        "description": "Root directory where generated assets are stored"
      },
      "dryRun": {
        "type": "boolean",
        "description": "Generate and render assets without publishing side effects"
      },
      "killSwitch": {
        "type": "boolean",
        "description": "Stop all automation when set to true"
      },
      "publicMediaBaseUrl": {
        "type": "string",
        "description": "Optional public base URL that serves files for live publishing"
      },
      "instagramAccessToken": {
        "type": "string",
        "description": "Instagram Graph API access token"
      },
      "instagramBusinessAccountId": {
        "type": "string",
        "description": "Instagram Business account ID"
      },
      "instagramApiBaseUrl": {
        "type": "string",
        "description": "Instagram Graph API base URL"
      },
      "tiktokAccessToken": {
        "type": "string",
        "description": "TikTok API access token"
      },
      "tiktokCreatorId": {
        "type": "string",
        "description": "TikTok creator ID"
      },
      "tiktokApiBaseUrl": {
        "type": "string",
        "description": "TikTok API base URL"
      },
      "facebookAppId": {
        "type": "string",
        "description": "Facebook app ID"
      },
      "facebookAppSecret": {
        "type": "string",
        "description": "Facebook app secret"
      },
      "facebookAccessToken": {
        "type": "string",
        "description": "Facebook access token"
      },
      "youtubeClientId": {
        "type": "string",
        "description": "YouTube OAuth client ID"
      },
      "youtubeClientSecret": {
        "type": "string",
        "description": "YouTube OAuth client secret"
      },
      "youtubeRefreshToken": {
        "type": "string",
        "description": "YouTube OAuth refresh token"
      },
      "pinterestAccessToken": {
        "type": "string",
        "description": "Pinterest access token"
      },
      "pinterestApiBaseUrl": {
        "type": "string",
        "description": "Pinterest API base URL"
      },
      "linkedinClientId": {
        "type": "string",
        "description": "LinkedIn client ID"
      },
      "linkedinClientSecret": {
        "type": "string",
        "description": "LinkedIn client secret"
      },
      "linkedinAccessToken": {
        "type": "string",
        "description": "LinkedIn access token"
      },
      "telegramBotToken": {
        "type": "string",
        "description": "Telegram bot token"
      },
      "telegramChannelId": {
        "type": "string",
        "description": "Telegram channel ID"
      },
      "xApiKey": {
        "type": "string",
        "description": "X (Twitter) API key"
      },
      "xApiSecret": {
        "type": "string",
        "description": "X API secret"
      },
      "xAccessToken": {
        "type": "string",
        "description": "X access token"
      },
      "xAccessSecret": {
        "type": "string",
        "description": "X access token secret"
      }
    }
  },
  "uiHints": {
    "geminiApiKey": {
      "label": "Gemini API Key",
      "sensitive": true
    },
    "defaultOutputDir": {
      "label": "Output Directory"
    },
    "dryRun": {
      "label": "Dry Run"
    },
    "killSwitch": {
      "label": "Kill Switch"
    },
    "instagramAccessToken": {
      "label": "Instagram Access Token",
      "sensitive": true
    },
    "tiktokAccessToken": {
      "label": "TikTok Access Token",
      "sensitive": true
    },
    "telegramBotToken": {
      "label": "Telegram Bot Token",
      "sensitive": true
    },
    "xAccessToken": {
      "label": "X Access Token",
      "sensitive": true
    }
  }
}
