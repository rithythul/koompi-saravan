{
  "id": "publisher",
  "name": "Sarawan Publisher",
  "description": "Multi-platform social media publishing, analytics, and content automation for Telegram and X",
  "version": "1.0.0",
  "main": "index.ts",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "geminiApiKey": {
        "type": "string",
        "description": "Google AI Studio API key for Gemini"
      },
      "defaultOutputDir": {
        "type": "string",
        "description": "Root directory where generated assets are stored"
      },
      "dryRun": {
        "type": "boolean",
        "description": "Generate and render assets without publishing side effects"
      },
      "killSwitch": {
        "type": "boolean",
        "description": "Stop all automation when set to true"
      },
      "publicMediaBaseUrl": {
        "type": "string",
        "description": "Optional public base URL that serves files for live publishing"
      },
      "telegramBotToken": {
        "type": "string",
        "description": "Telegram bot token"
      },
      "telegramChannelId": {
        "type": "string",
        "description": "Telegram channel ID"
      },
      "xApiKey": {
        "type": "string",
        "description": "X (Twitter) API key"
      },
      "xApiSecret": {
        "type": "string",
        "description": "X API secret"
      },
      "xAccessToken": {
        "type": "string",
        "description": "X access token"
      },
      "xAccessSecret": {
        "type": "string",
        "description": "X access token secret"
      }
    }
  },
  "uiHints": {
    "geminiApiKey": {
      "label": "Gemini API Key",
      "sensitive": true
    },
    "defaultOutputDir": {
      "label": "Output Directory"
    },
    "dryRun": {
      "label": "Dry Run"
    },
    "killSwitch": {
      "label": "Kill Switch"
    },
    "telegramBotToken": {
      "label": "Telegram Bot Token",
      "sensitive": true
    },
    "xAccessToken": {
      "label": "X Access Token",
      "sensitive": true
    }
  }
}
