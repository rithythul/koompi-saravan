# ===================================================================
# Sarawan Social - Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your credentials

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# Port for the API server
PORT=3001

# API key for authentication (required in production)
# Generate a strong random key for production!
API_KEY=your-api-key-here

# Disable authentication (ONLY for development!)
# Never set this in production!
AUTH_DISABLED=false

# CORS allowed origins (comma-separated)
# In production, set specific origins. Leave empty for default behavior.
# Examples: https://example.com,https://app.example.com
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection URL (required for analytics storage)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://sarawan:password@localhost:5432/sarawan

# ------------------------------------------------------------------------------
# Media Storage Configuration
# ------------------------------------------------------------------------------
# Directory for local media storage
MEDIA_DIR=./var/media

# Maximum upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE=104857600

# Allowed media types (comma-separated)
ALLOWED_MEDIA_TYPES=image/*,video/*

# Base URL for generating media URLs
BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Platform Credentials
# ------------------------------------------------------------------------------

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ORGANIZATION_ID=your-org-id

# Facebook
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-page-id

# Instagram
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-account-id

# TikTok
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_CLIENT_KEY=your-tiktok-client-key

# YouTube
YOUTUBE_ACCESS_TOKEN=your-youtube-access-token
YOUTUBE_CHANNEL_ID=your-channel-id

# Pinterest
PINTEREST_ACCESS_TOKEN=your-pinterest-access-token
PINTEREST_BOARD_ID=your-board-id

# Telegram
TELEGRAM_CHANNEL_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id

# X (Twitter)
X_ACCESS_TOKEN=your-x-access-token
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# ------------------------------------------------------------------------------
# Optional: AI Features
# ------------------------------------------------------------------------------
# Gemini API for content generation
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# Optional: Output Configuration
# ------------------------------------------------------------------------------
# Default output directory for generated content
DEFAULT_OUTPUT_DIR=./var/outputs

# Dry run mode (no actual publishing)
DRY_RUN=false

# Kill switch (emergency stop)
KILL_SWITCH=false

# ------------------------------------------------------------------------------
# Deployment
# ------------------------------------------------------------------------------
# Environment: development, staging, production
NODE_ENV=development
